[gd_scene load_steps=6 format=3]

[ext_resource type="PackedScene" path="res://drawing/canvas/drawing_canvas.tscn" id="1"]
[ext_resource type="Script" path="res://app/scripts/controllers/home_controller.gd" id="2"]
[ext_resource type="Script" path="res://app/scripts/controllers/editor_controller.gd" id="3"]
[ext_resource type="Script" path="res://app/scripts/controllers/rig_controller.gd" id="4"]
[ext_resource type="Script" path="res://app/scripts/controllers/world_controller.gd" id="5"]

[sub_resource type="GDScript" id="GDScript_main"]
script/source = "extends Control

var home_ctrl := HomeController.new()
var editor_ctrl := EditorController.new()
var rig_ctrl := RigController.new()
var anim_ctrl := AnimationController.new()
var world_ctrl := WorldController.new()
var export_ctrl := ExportController.new()

@onready var status_label: Label = $RootVBox/HeaderBar/StatusLabel
@onready var canvas_view: DrawingCanvasView = $RootVBox/WorkspaceSplit/CanvasContainer/DrawingCanvas
@onready var inspect_label: Label = $RootVBox/WorkspaceSplit/SidePanel/InspectorText

func _ready() -> void:
	_refresh_status(\"LIVING CANVAS Ready | Offline SQLite v%d | Strokes: %d\" % [
		DatabaseManager.sqlite_manager.get_schema_version() if DatabaseManager.is_ready else 0,
		AppState.drawing_bridge.get_stroke_count() if AppState.drawing_bridge != null else 0
	])
	EventBus.stroke_committed.connect(_on_stroke_committed)

func _process(delta: float) -> void:
	if AppState.active_stickman_rig_id > 0:
		anim_ctrl.step(delta)
	if world_ctrl.is_simulating:
		world_ctrl.step_simulation(delta, 1.0, false, 1.0, 0.0, 0.0)
		canvas_view.refresh_canvas()

func _on_stroke_committed(_stroke_id: int) -> void:
	var res_json := AppState.recognition_bridge.classify_drawing(AppState.drawing_bridge)
	var parsed = JSON.parse_string(res_json)
	var cat := str(parsed.get(\"category\", \"other\")) if typeof(parsed) == TYPE_DICTIONARY else \"other\"
	var conf := float(parsed.get(\"confidence\", 0.0)) if typeof(parsed) == TYPE_DICTIONARY else 0.0
	_refresh_status(\"Preserved Original Strokes: %d | Offline Recognition: %s (%.0f%%)\" % [
		AppState.drawing_bridge.get_stroke_count(), cat, conf * 100.0
	])
	inspect_label.text = \"Classified: %s\\nConfidence: %.2f\\nOriginal Strokes: %d\" % [
		cat, conf, AppState.drawing_bridge.get_stroke_count()
	]

func _refresh_status(msg: String) -> void:
	if status_label != null:
		status_label.text = msg

func _on_btn_pencil_pressed() -> void:
	canvas_view.input_handler.controller.is_eraser_active = false
	editor_ctrl.toolbar.select_tool(0)
	_refresh_status(\"Tool: Pencil (Original Stroke Preservation Mode)\")

func _on_btn_marker_pressed() -> void:
	canvas_view.input_handler.controller.is_eraser_active = false
	editor_ctrl.toolbar.select_tool(2)
	_refresh_status(\"Tool: Marker\")

func _on_btn_eraser_pressed() -> void:
	canvas_view.input_handler.controller.is_eraser_active = true
	editor_ctrl.toolbar.select_tool(4)
	_refresh_status(\"Tool: Eraser\")

func _on_btn_auto_rig_pressed() -> void:
	var rig_id := rig_ctrl.auto_rig_stickman(AppState.active_stickman_object_id, Rect2(360, 160, 220, 360))
	canvas_view.refresh_canvas()
	_refresh_status(\"Auto-Rigged Original Stickman Artwork (Rig ID #%d, 11 Joints, 10 Bones)\" % rig_id)

func _on_btn_walk_pressed() -> void:
	if AppState.active_stickman_rig_id <= 0:
		_on_btn_auto_rig_pressed()
	anim_ctrl.play(\"walk\")
	canvas_view.refresh_canvas()
	_refresh_status(\"Playing 'walk' cycle on User's Original Rigged Stickman\")

func _on_btn_drive_car_pressed() -> void:
	var mounted := world_ctrl.toggle_stickman_in_car()
	world_ctrl.is_simulating = mounted
	_refresh_status(\"Stickman Mounted & Driving Drawn Car!\" if mounted else \"Stickman Exited Drawn Car\")

func _on_btn_save_pressed() -> void:
	var ok := ProjectManager.save_current_project()
	_refresh_status(\"Project & Editable Strokes Saved to SQLite (ok=%s)\" % str(ok))
"

[node name="MainStudio" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = SubResource("GDScript_main")

[node name="StudioBackground" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.0705882, 0.0823529, 0.117647, 1)

[node name="RootVBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="HeaderBar" type="HBoxContainer" parent="RootVBox"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2

[node name="BrandTitle" type="Label" parent="RootVBox/HeaderBar"]
layout_mode = 2
text = "  LIVING CANVAS (Draw City)  |  "

[node name="BtnPencil" type="Button" parent="RootVBox/HeaderBar"]
layout_mode = 2
text = "Pencil"

[node name="BtnMarker" type="Button" parent="RootVBox/HeaderBar"]
layout_mode = 2
text = "Marker"

[node name="BtnEraser" type="Button" parent="RootVBox/HeaderBar"]
layout_mode = 2
text = "Eraser"

[node name="BtnAutoRig" type="Button" parent="RootVBox/HeaderBar"]
layout_mode = 2
text = "Rig Stickman"

[node name="BtnWalk" type="Button" parent="RootVBox/HeaderBar"]
layout_mode = 2
text = "Animate Walk"

[node name="BtnDriveCar" type="Button" parent="RootVBox/HeaderBar"]
layout_mode = 2
text = "Enter & Drive Car"

[node name="BtnSave" type="Button" parent="RootVBox/HeaderBar"]
layout_mode = 2
text = "Save to SQLite"

[node name="StatusLabel" type="Label" parent="RootVBox/HeaderBar"]
layout_mode = 2
size_flags_horizontal = 3
text = "Initializing..."
horizontal_alignment = 2

[node name="WorkspaceSplit" type="HSplitContainer" parent="RootVBox"]
layout_mode = 2
size_flags_vertical = 3
split_offset = 1480

[node name="CanvasContainer" type="Panel" parent="RootVBox/WorkspaceSplit"]
layout_mode = 2
size_flags_horizontal = 3

[node name="DrawingCanvas" parent="RootVBox/WorkspaceSplit/CanvasContainer" instance=ExtResource("1")]
layout_mode = 1

[node name="SidePanel" type="VBoxContainer" parent="RootVBox/WorkspaceSplit"]
custom_minimum_size = Vector2(280, 0)
layout_mode = 2

[node name="SideHeader" type="Label" parent="RootVBox/WorkspaceSplit/SidePanel"]
layout_mode = 2
text = "Object & Rig Inspector"

[node name="InspectorText" type="Label" parent="RootVBox/WorkspaceSplit/SidePanel"]
layout_mode = 2
text = "Draw on the canvas with finger or stylus. Original strokes are preserved."
autowrap_mode = 2

[connection signal="pressed" from="RootVBox/HeaderBar/BtnPencil" to="." method="_on_btn_pencil_pressed"]
[connection signal="pressed" from="RootVBox/HeaderBar/BtnMarker" to="." method="_on_btn_marker_pressed"]
[connection signal="pressed" from="RootVBox/HeaderBar/BtnEraser" to="." method="_on_btn_eraser_pressed"]
[connection signal="pressed" from="RootVBox/HeaderBar/BtnAutoRig" to="." method="_on_btn_auto_rig_pressed"]
[connection signal="pressed" from="RootVBox/HeaderBar/BtnWalk" to="." method="_on_btn_walk_pressed"]
[connection signal="pressed" from="RootVBox/HeaderBar/BtnDriveCar" to="." method="_on_btn_drive_car_pressed"]
[connection signal="pressed" from="RootVBox/HeaderBar/BtnSave" to="." method="_on_btn_save_pressed"]

