[gd_scene load_steps=6 format=3]

[ext_resource type="PackedScene" path="res://drawing/canvas/drawing_canvas.tscn" id="1"]
[ext_resource type="Script" path="res://app/scripts/controllers/home_controller.gd" id="2"]
[ext_resource type="Script" path="res://app/scripts/controllers/editor_controller.gd" id="3"]
[ext_resource type="Script" path="res://app/scripts/controllers/rig_controller.gd" id="4"]
[ext_resource type="Script" path="res://app/scripts/controllers/world_controller.gd" id="5"]

[sub_resource type="GDScript" id="GDScript_main"]
script/source = "extends Control

var home_ctrl := HomeController.new()
var editor_ctrl := EditorController.new()
var rig_ctrl := RigController.new()
var anim_ctrl := AnimationController.new()
var world_ctrl := WorldController.new()
var export_ctrl := ExportController.new()

@onready var top_nav_panel: PanelContainer = $RootVBox/TopNavPanel
@onready var sub_toolbar_panel: PanelContainer = $RootVBox/SubToolbarPanel
@onready var side_panel_container: PanelContainer = $RootVBox/WorkspaceSplit/SidePanelContainer
@onready var canvas_panel: PanelContainer = $RootVBox/WorkspaceSplit/CanvasContainer
@onready var status_label: Label = $RootVBox/TopNavPanel/TopNavHBox/StatusLabel
@onready var canvas_view: DrawingCanvasView = $RootVBox/WorkspaceSplit/CanvasContainer/DrawingCanvas
@onready var inspect_label: Label = $RootVBox/WorkspaceSplit/SidePanelContainer/SideMargin/SideVBox/InspectorCard/InspectorText
@onready var sub_toolbar: HBoxContainer = $RootVBox/SubToolbarPanel/SubToolbarHBox

var _screen_buttons: Dictionary = {}
var _next_city_object_id: int = 200
var _city_ambient_active: bool = true

func _ready() -> void:
	_apply_studio_chrome()
	_refresh_status(\"Ready  •  Offline SQLite v%d  •  Preserved Strokes: %d\" % [
		DatabaseManager.sqlite_manager.get_schema_version() if DatabaseManager.is_ready else 0,
		AppState.drawing_bridge.get_stroke_count() if AppState.drawing_bridge != null else 0
	])
	EventBus.stroke_committed.connect(_on_stroke_committed)
	_switch_screen(\"drawing_editor\")
	_update_inspector_panel(\"none\", 0.0)

func _apply_studio_chrome() -> void:
	top_nav_panel.add_theme_stylebox_override(\"panel\", StudioButtons.make_flat_box(\"#131722\", \"#22293A\", 0, 16, 8))
	sub_toolbar_panel.add_theme_stylebox_override(\"panel\", StudioButtons.make_flat_box(\"#171C29\", \"#232B3E\", 0, 16, 8))
	side_panel_container.add_theme_stylebox_override(\"panel\", StudioButtons.make_flat_box(\"#141824\", \"#232B3E\", 10, 14, 14))
	canvas_panel.add_theme_stylebox_override(\"panel\", StudioButtons.make_flat_box(\"#0E1118\", \"#232B3E\", 10, 2, 2))
	$RootVBox/WorkspaceSplit/SidePanelContainer/SideMargin/SideVBox/InspectorCard.add_theme_stylebox_override(
		\"panel\", StudioButtons.make_flat_box(\"#1B2130\", \"#2D374E\", 8, 12, 10)
	)

	_screen_buttons = {
		\"welcome\": $RootVBox/TopNavPanel/TopNavHBox/ScreenTabsHBox/Tab1Welcome,
		\"profile_setup\": $RootVBox/TopNavPanel/TopNavHBox/ScreenTabsHBox/Tab2Profile,
		\"home\": $RootVBox/TopNavPanel/TopNavHBox/ScreenTabsHBox/Tab3Home,
		\"drawing_editor\": $RootVBox/TopNavPanel/TopNavHBox/ScreenTabsHBox/Tab4Editor,
		\"rig_editor\": $RootVBox/TopNavPanel/TopNavHBox/ScreenTabsHBox/Tab5Rig,
		\"animation_studio\": $RootVBox/TopNavPanel/TopNavHBox/ScreenTabsHBox/Tab6Anim,
		\"living_world\": $RootVBox/TopNavPanel/TopNavHBox/ScreenTabsHBox/Tab7World,
		\"settings\": $RootVBox/TopNavPanel/TopNavHBox/ScreenTabsHBox/Tab8Settings
	}

	StudioButtons.style_secondary_button($RootVBox/WorkspaceSplit/SidePanelContainer/SideMargin/SideVBox/CityGrid/BtnAddBuilding, false)
	StudioButtons.style_secondary_button($RootVBox/WorkspaceSplit/SidePanelContainer/SideMargin/SideVBox/CityGrid/BtnAddTree, false)
	StudioButtons.style_secondary_button($RootVBox/WorkspaceSplit/SidePanelContainer/SideMargin/SideVBox/CityGrid/BtnAddCloud, false)
	StudioButtons.style_secondary_button($RootVBox/WorkspaceSplit/SidePanelContainer/SideMargin/SideVBox/CityGrid/BtnAddBird, false)
	StudioButtons.style_secondary_button($RootVBox/WorkspaceSplit/SidePanelContainer/SideMargin/SideVBox/CityGrid/BtnAddCar, false)
	StudioButtons.style_secondary_button($RootVBox/WorkspaceSplit/SidePanelContainer/SideMargin/SideVBox/CityGrid/BtnAddCitizen, false)

	StudioButtons.style_accent_button($RootVBox/WorkspaceSplit/SidePanelContainer/SideMargin/SideVBox/QuickRigBtn, \"#1E3A8A\", \"#3B82F6\")
	StudioButtons.style_accent_button($RootVBox/WorkspaceSplit/SidePanelContainer/SideMargin/SideVBox/QuickWalkBtn, \"#065F46\", \"#10B981\")
	StudioButtons.style_accent_button($RootVBox/WorkspaceSplit/SidePanelContainer/SideMargin/SideVBox/QuickJumpBtn, \"#78350F\", \"#F59E0B\")
	StudioButtons.style_accent_button($RootVBox/WorkspaceSplit/SidePanelContainer/SideMargin/SideVBox/QuickStopAnimBtn, \"#374151\", \"#6B7280\")
	StudioButtons.style_accent_button($RootVBox/WorkspaceSplit/SidePanelContainer/SideMargin/SideVBox/QuickDriveCarBtn, \"#4C1D95\", \"#8B5CF6\")
	StudioButtons.style_accent_button($RootVBox/WorkspaceSplit/SidePanelContainer/SideMargin/SideVBox/QuickSaveBtn, \"#1E293B\", \"#38BDF8\")
	StudioButtons.style_accent_button($RootVBox/WorkspaceSplit/SidePanelContainer/SideMargin/SideVBox/QuickLoadCityBtn, \"#14532D\", \"#22C55E\")

func _process(delta: float) -> void:
	var needs_redraw := false
	if _city_ambient_active and canvas_view != null and canvas_view.renderer != null:
		canvas_view.renderer.city_time_sec += delta
		needs_redraw = true
	if AppState.active_stickman_rig_id > 0:
		anim_ctrl.step(delta)
		needs_redraw = true
	if world_ctrl.is_simulating:
		var move_dir := Input.get_axis(\"ui_left\", \"ui_right\")
		if absf(move_dir) < 0.05:
			move_dir = 0.45
		var jump_req := Input.is_action_just_pressed(\"ui_accept\")
		world_ctrl.step_simulation(delta, move_dir, jump_req, move_dir, 0.0, 0.0)
		needs_redraw = true
	if needs_redraw and canvas_view != null:
		canvas_view.refresh_canvas()

func _switch_screen(screen_id: String) -> void:
	StudioNavigation.navigate_to(screen_id)
	for key in _screen_buttons.keys():
		StudioButtons.style_secondary_button(_screen_buttons[key], key == screen_id)
	_rebuild_sub_toolbar(screen_id)

func _rebuild_sub_toolbar(screen_id: String) -> void:
	if sub_toolbar == null:
		return
	for child in sub_toolbar.get_children():
		child.queue_free()

	if screen_id == \"welcome\":
		_add_tool_btn(\"Create Local Profile & Continue\", func(): _switch_screen(\"profile_setup\"), true)
		_add_tool_btn(\"Open City Canvas Directly\", func(): _switch_screen(\"drawing_editor\"))
	elif screen_id == \"profile_setup\":
		_add_tool_btn(\"Save Local Profile 'Offline Creator'\", func():
			if DatabaseManager.is_ready:
				var uid := DatabaseManager.storage_bridge.create_user_profile(\"Offline Creator\", \"artist_01\")
				AppState.current_user_id = uid
				_refresh_status(\"Created Offline Profile #%d\" % uid)
			_switch_screen(\"home\")
		, true)
	elif screen_id == \"home\":
		_add_tool_btn(\"📂 Load My Saved City (SQLite)\", _on_btn_load_saved_city_pressed, true)
		_add_tool_btn(\"🏙️ Load Full Demo Draw City\", _on_btn_load_demo_city_pressed)
		_add_tool_btn(\"+ New Blank City Project\", func():
			var pid := home_ctrl.create_project(\"Draw City #\" + str(Time.get_ticks_msec() % 1000))
			AppState.drawing_bridge.clear_canvas()
			AppState.active_stickman_rig_id = 0
			canvas_view.refresh_canvas()
			_refresh_status(\"Created New Blank City Project #%d\" % pid)
			_switch_screen(\"drawing_editor\")
		)
		_add_tool_btn(\"Load Sample Stickman + Car\", func():
			AppState.drawing_bridge.clear_canvas()
			AppState.active_stickman_rig_id = 0
			AppState.drawing_bridge.load_sample_car()
			AppState.drawing_bridge.commit_unassigned_strokes_to_object(2, 2)
			AppState.drawing_bridge.load_sample_stickman()
			AppState.drawing_bridge.commit_unassigned_strokes_to_object(1, 1)
			canvas_view.refresh_canvas()
			_on_stroke_committed(0)
			_refresh_status(\"Loaded Preserved Sample Stickman + Car\")
		)
	elif screen_id == \"drawing_editor\":
		_add_tool_btn(\"Pencil\", _on_btn_pencil_pressed, true)
		_add_tool_btn(\"Pen\", func():
			canvas_view.input_handler.controller.is_eraser_active = false
			editor_ctrl.toolbar.select_tool(1)
			_refresh_status(\"Tool: Pen (Smooth Ink)\")
		)
		_add_tool_btn(\"Marker\", _on_btn_marker_pressed)
		_add_tool_btn(\"Soft Brush\", func():
			canvas_view.input_handler.controller.is_eraser_active = false
			editor_ctrl.toolbar.select_tool(3)
			_refresh_status(\"Tool: Soft Brush\")
		)
		_add_tool_btn(\"Eraser\", _on_btn_eraser_pressed)
		_add_color_swatch(\"White\", \"#F9FAFB\")
		_add_color_swatch(\"Gold\", \"#F59E0B\")
		_add_color_swatch(\"Blue\", \"#3B82F6\")
		_add_color_swatch(\"Emerald\", \"#10B981\")
		_add_color_swatch(\"Pink\", \"#EC4899\")
		_add_tool_btn(\"🏙️ Generate Demo City\", _on_btn_load_demo_city_pressed)
		_add_tool_btn(\"Undo\", func():
			UndoManager.perform_undo()
			canvas_view.refresh_canvas()
			_refresh_status(\"Undo applied\")
		)
		_add_tool_btn(\"Clear All\", func():
			anim_ctrl.stop()
			world_ctrl.is_simulating = false
			AppState.stickman_in_car = false
			AppState.active_stickman_rig_id = 0
			AppState.physics_bridge.reset_bodies()
			AppState.drawing_bridge.clear_canvas()
			canvas_view.refresh_canvas()
			_update_inspector_panel(\"none\", 0.0)
			_refresh_status(\"Canvas & City Reset\")
		)
	elif screen_id == \"rig_editor\":
		_add_tool_btn(\"Auto-Rig Stickman Citizen (11 Joints / 10 Bones)\", _on_btn_auto_rig_pressed, true)
		_add_tool_btn(\"Show / Hide Skeleton Overlay\", func():
			canvas_view.renderer.show_rig_overlay = not canvas_view.renderer.show_rig_overlay
			canvas_view.refresh_canvas()
			_refresh_status(\"Skeleton Overlay: \" + (\"VISIBLE\" if canvas_view.renderer.show_rig_overlay else \"HIDDEN\"))
		)
		_add_tool_btn(\"Reset Pose to Original Drawing\", func():
			anim_ctrl.stop()
			canvas_view.refresh_canvas()
			_refresh_status(\"Restored Original Drawn Rest Pose\")
		)
	elif screen_id == \"animation_studio\":
		for clip in [\"idle\", \"walk\", \"run\", \"jump\", \"fall\", \"fly\", \"swim\"]:
			var clip_name: String = clip
			_add_tool_btn(\"▶ \" + clip_name.capitalize(), func():
				if AppState.active_stickman_rig_id <= 0:
					_on_btn_auto_rig_pressed()
				anim_ctrl.play(clip_name)
				_on_stroke_committed(0)
				_refresh_status(\"Animating '\" + clip_name + \"' on Original Citizen Artwork\")
			, clip_name == \"walk\")
		_add_tool_btn(\"⏸ Pause\", func():
			anim_ctrl.pause()
			_refresh_status(\"Animation Paused\")
		)
		_add_tool_btn(\"⏹ Stop & Reset Pose\", _on_btn_stop_anim_pressed)
	elif screen_id == \"living_world\":
		_add_tool_btn(\"▶ Toggle City Physics\", func():
			world_ctrl.is_simulating = not world_ctrl.is_simulating
			_refresh_status(\"City Physics: \" + (\"RUNNING\" if world_ctrl.is_simulating else \"PAUSED\"))
		, true)
		_add_tool_btn(\"🚗 Citizen Enter / Drive Car\", _on_btn_drive_car_pressed)
		_add_tool_btn(\"🏙️ Load Full Demo Draw City\", _on_btn_load_demo_city_pressed)
		_add_tool_btn(\"↺ Reset City Positions\", func():
			world_ctrl.is_simulating = false
			AppState.stickman_in_car = false
			AppState.physics_bridge.reset_bodies()
			canvas_view.refresh_canvas()
			_on_stroke_committed(0)
			_refresh_status(\"City Positions Reset to Origin\")
		)
	elif screen_id == \"settings\":
		_add_tool_btn(\"Backup SQLite Database\", func():
			var ok := DatabaseManager.sqlite_manager.create_backup()
			_refresh_status(\"SQLite Backup: \" + (\"SAVED\" if ok else \"FAILED\"))
		, true)
		_add_tool_btn(\"Export Editable Project JSON\", func():
			var ok := export_ctrl.export_project_bundle()
			_refresh_status(\"Exported Editable JSON Bundle: \" + str(ok))
		)
		_add_tool_btn(\"Export Canvas PNG\", func():
			var ok := export_ctrl.export_canvas_png(get_viewport())
			_refresh_status(\"Exported PNG to user://exports/images/: \" + str(ok))
		)
		_add_tool_btn(\"Toggle Grid\", func():
			canvas_view.renderer.show_grid = not canvas_view.renderer.show_grid
			canvas_view.refresh_canvas()
		)

func _add_tool_btn(label_text: String, callback: Callable, primary: bool = false) -> void:
	var btn := Button.new()
	btn.text = label_text
	if primary:
		StudioButtons.style_primary_button(btn, \"#2563EB\")
	else:
		StudioButtons.style_secondary_button(btn, false)
	btn.pressed.connect(callback)
	sub_toolbar.add_child(btn)

func _add_color_swatch(label_text: String, hex_code: String) -> void:
	var btn := Button.new()
	btn.text = \"● \" + label_text
	StudioButtons.style_accent_button(btn, \"#1E2433\", hex_code)
	btn.add_theme_color_override(\"font_color\", Color.html(hex_code))
	btn.pressed.connect(func():
		canvas_view.input_handler.controller.is_eraser_active = false
		editor_ctrl.set_brush_color(hex_code)
		_refresh_status(\"Brush Color: \" + label_text + \" (\" + hex_code + \")\")
	)
	sub_toolbar.add_child(btn)

func _commit_drawn_city_element(role_label: String, target_object_id: int, part_id: int) -> void:
	var count := AppState.drawing_bridge.commit_unassigned_strokes_to_object(target_object_id, part_id)
	if count <= 0:
		_refresh_status(\"Draw a \" + role_label + \" on the canvas first, then click '+ \" + role_label + \"'!\")
		return
	if part_id == 1:
		# Automatically rig the newly drawn stickman citizen!
		var rig_id := rig_ctrl.auto_rig_stickman(1, Rect2(360, 160, 220, 360))
		_refresh_status(\"Added Drawn Citizen (%d strokes) & Rigged (#%d)! Draw your next city object.\" % [count, rig_id])
	else:
		_refresh_status(\"Added Drawn %s (%d strokes) to City! Now draw your next object.\" % [role_label, count])
	_on_stroke_committed(0)
	canvas_view.refresh_canvas()

func _on_add_building_pressed() -> void:
	_next_city_object_id += 1
	_commit_drawn_city_element(\"Building\", _next_city_object_id, 10)

func _on_add_tree_pressed() -> void:
	_next_city_object_id += 1
	_commit_drawn_city_element(\"Tree\", _next_city_object_id, 11)

func _on_add_cloud_pressed() -> void:
	_next_city_object_id += 1
	_commit_drawn_city_element(\"Drifting Cloud\", _next_city_object_id, 3)

func _on_add_bird_pressed() -> void:
	_next_city_object_id += 1
	_commit_drawn_city_element(\"Flying Bird\", _next_city_object_id, 4)

func _on_add_car_pressed() -> void:
	_commit_drawn_city_element(\"Car\", 2, 2)

func _on_add_citizen_pressed() -> void:
	_commit_drawn_city_element(\"Stickman Citizen\", 1, 1)

func _on_btn_load_demo_city_pressed() -> void:
	anim_ctrl.stop()
	world_ctrl.is_simulating = false
	AppState.stickman_in_car = false
	AppState.physics_bridge.reset_bodies()
	AppState.drawing_bridge.clear_canvas()
	AppState.drawing_bridge.load_sample_city()
	var rig_id := rig_ctrl.auto_rig_stickman(1, Rect2(360, 160, 220, 360))
	anim_ctrl.play(\"walk\")
	canvas_view.refresh_canvas()
	_on_stroke_committed(0)
	_refresh_status(\"Loaded Complete Interactive Draw City (Buildings, Tree, Drifting Clouds, Bird, Car & Walking Citizen #%d)\" % rig_id)

func _on_btn_load_saved_city_pressed() -> void:
	var ok := ProjectManager.load_project(AppState.current_project_id)
	if ok and AppState.drawing_bridge.get_stroke_count() > 0:
		rig_ctrl.auto_rig_stickman(1, Rect2(360, 160, 220, 360))
		canvas_view.refresh_canvas()
		_on_stroke_committed(0)
		_refresh_status(\"Loaded Saved City Project #%d from SQLite (%d editable strokes)\" % [
			AppState.current_project_id, AppState.drawing_bridge.get_stroke_count()
		])
	else:
		_refresh_status(\"No saved strokes found in Project #%d yet — draw or click 'Save City to SQLite' first.\" % AppState.current_project_id)

func _on_stroke_committed(_stroke_id: int) -> void:
	var res_json := AppState.recognition_bridge.classify_drawing(AppState.drawing_bridge)
	var parsed = JSON.parse_string(res_json)
	var cat := str(parsed.get(\"category\", \"other\")) if typeof(parsed) == TYPE_DICTIONARY else \"other\"
	var conf := float(parsed.get(\"confidence\", 0.0)) if typeof(parsed) == TYPE_DICTIONARY else 0.0
	var unassigned := AppState.drawing_bridge.get_unassigned_stroke_count() if AppState.drawing_bridge != null else 0
	_refresh_status(\"Total City Strokes: %d (New Unassigned: %d)  •  Detected: %s (%.0f%%)\" % [
		AppState.drawing_bridge.get_stroke_count(), unassigned, cat.capitalize(), conf * 100.0
	])
	_update_inspector_panel(cat, conf)

func _update_inspector_panel(cat: String, conf: float) -> void:
	if inspect_label == null:
		return
	var active_clip := AppState.animation_bridge.get_active_clip_name() if AppState.animation_bridge != null else \"idle\"
	var total_strokes := AppState.drawing_bridge.get_stroke_count() if AppState.drawing_bridge != null else 0
	var unassigned := AppState.drawing_bridge.get_unassigned_stroke_count() if AppState.drawing_bridge != null else 0
	inspect_label.text = (
		\"Recognized:  %s (%.0f%%)\\n\" % [cat.capitalize(), conf * 100.0] +
		\"Total City Strokes:  %d  (New: %d)\\n\" % [total_strokes, unassigned] +
		\"Citizen Rig:  %s\\n\" % (\"#\" + str(AppState.active_stickman_rig_id) + \" (11 Joints)\" if AppState.active_stickman_rig_id > 0 else \"Not Rigged\") +
		\"Animation:  %s  |  Mode:  %s\" % [active_clip.capitalize(), \"Driving Car\" if AppState.stickman_in_car else \"On Foot\"]
	)

func _refresh_status(msg: String) -> void:
	if status_label != null:
		status_label.text = msg

func _on_btn_pencil_pressed() -> void:
	canvas_view.input_handler.controller.is_eraser_active = false
	editor_ctrl.toolbar.select_tool(0)
	_refresh_status(\"Tool: Pencil (Original Stroke Preservation)\")

func _on_btn_marker_pressed() -> void:
	canvas_view.input_handler.controller.is_eraser_active = false
	editor_ctrl.toolbar.select_tool(2)
	_refresh_status(\"Tool: Marker\")

func _on_btn_eraser_pressed() -> void:
	canvas_view.input_handler.controller.is_eraser_active = true
	editor_ctrl.toolbar.select_tool(4)
	_refresh_status(\"Tool: Eraser\")

func _on_btn_auto_rig_pressed() -> void:
	anim_ctrl.stop()
	if AppState.drawing_bridge.get_stroke_count() == 0:
		AppState.drawing_bridge.load_sample_stickman()
	# If user just drew a stickman without clicking '+ Citizen', assign those unassigned strokes to Citizen (1, 1)
	if AppState.drawing_bridge.get_unassigned_stroke_count() > 0:
		AppState.drawing_bridge.commit_unassigned_strokes_to_object(1, 1)
	var rig_id := rig_ctrl.auto_rig_stickman(AppState.active_stickman_object_id, Rect2(360, 160, 220, 360))
	canvas_view.refresh_canvas()
	_on_stroke_committed(0)
	_refresh_status(\"Auto-Rigged Citizen Stickman (Rig #%d • Buildings/Trees Stay Anchored)\" % rig_id)

func _on_btn_walk_pressed() -> void:
	if AppState.active_stickman_rig_id <= 0:
		_on_btn_auto_rig_pressed()
	anim_ctrl.play(\"walk\")
	canvas_view.refresh_canvas()
	_on_stroke_committed(0)
	_refresh_status(\"Playing Natural 'Walk' Cycle on Your Citizen Stickman\")

func _on_btn_jump_pressed() -> void:
	if AppState.active_stickman_rig_id <= 0:
		_on_btn_auto_rig_pressed()
	anim_ctrl.play(\"jump\")
	canvas_view.refresh_canvas()
	_on_stroke_committed(0)
	_refresh_status(\"Playing 'Jump' Cycle on Your Citizen Stickman\")

func _on_btn_stop_anim_pressed() -> void:
	anim_ctrl.stop()
	world_ctrl.is_simulating = false
	AppState.stickman_in_car = false
	AppState.physics_bridge.reset_bodies()
	canvas_view.refresh_canvas()
	_on_stroke_committed(0)
	_refresh_status(\"Stopped Animation & Restored Original Rest Pose\")

func _on_btn_drive_car_pressed() -> void:
	if AppState.drawing_bridge.get_stroke_count() == 0:
		AppState.drawing_bridge.load_sample_city()
		rig_ctrl.auto_rig_stickman(1, Rect2(360, 160, 220, 360))
	var mounted := world_ctrl.toggle_stickman_in_car()
	world_ctrl.is_simulating = mounted
	if not mounted:
		AppState.physics_bridge.reset_bodies()
		canvas_view.refresh_canvas()
	_on_stroke_committed(0)
	_refresh_status(\"Citizen Driving Car Through City (Buildings Stay Anchored!)\" if mounted else \"Exited Car & Reset Position\")

func _on_btn_save_pressed() -> void:
	var ok := ProjectManager.save_current_project()
	_refresh_status(\"Saved Entire City & Editable Strokes to SQLite Database (ok=%s)\" % str(ok))

func _on_tab_welcome() -> void: _switch_screen(\"welcome\")
func _on_tab_profile() -> void: _switch_screen(\"profile_setup\")
func _on_tab_home() -> void: _switch_screen(\"home\")
func _on_tab_editor() -> void: _switch_screen(\"drawing_editor\")
func _on_tab_rig() -> void: _switch_screen(\"rig_editor\")
func _on_tab_anim() -> void: _switch_screen(\"animation_studio\")
func _on_tab_world() -> void: _switch_screen(\"living_world\")
func _on_tab_settings() -> void: _switch_screen(\"settings\")
"

[node name="MainStudio" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = SubResource("GDScript_main")

[node name="StudioBackground" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.0627451, 0.0745098, 0.105882, 1)

[node name="RootVBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/separation = 0

[node name="TopNavPanel" type="PanelContainer" parent="RootVBox"]
layout_mode = 2

